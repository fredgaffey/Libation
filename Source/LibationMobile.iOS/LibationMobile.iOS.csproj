<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>16.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>LibationMobile.iOS</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The icon set in Assets.xcassets. Rendered from LibationMobile/Icon/icon.svg by render-icons.sh. -->
    <AppIcon>AppIcon</AppIcon>
    <ApplicationId>io.github.freddygaffey.libation</ApplicationId>
    <ApplicationTitle>Libation</ApplicationTitle>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" Version="12.1.2" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.0" />
    <PackageReference Include="Speechwarp.Voice" Version="0.3.7" />
    <!-- Kokoro, the neural voices, runs on the phone through ONNX Runtime. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.23.2" />
  </ItemGroup>

  <!-- iOS plays through AVFoundation (see AudioBackend in AppDelegate), so SoundFlow's native libraries are not
       needed. Its iOS frameworks are device-only and would otherwise be linked into simulator builds and fail. -->
  <ItemGroup>
    <PackageReference Include="SoundFlow" Version="1.4.1" ExcludeAssets="native;build;buildTransitive" />
    <PackageReference Include="SoundFlow.Codecs.FFMpeg" Version="1.4.0" ExcludeAssets="native;build;buildTransitive" />
  </ItemGroup>

  <!-- Pulled in by Dinah.Core for desktop keychain storage (CredentialManagerOsSecretStore), which this app never
       uses: tokens are kept in the app's own file. It imports macOS's System.framework, which iOS does not have. -->
  <ItemGroup>
    <PackageReference Include="Devlooped.CredentialManager" Version="2.7.0" ExcludeAssets="all" />
  </ItemGroup>

  <!-- The home-screen widget, from Widget/build-widget.sh. Left out when that has not been run, such as on a
       machine without Xcode's signing set up; the app then runs without it. -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);Widget/**</DefaultItemExcludes>
    <_WidgetProducts>$(MSBuildThisFileDirectory)Widget/build/Build/Products</_WidgetProducts>
    <_WidgetPlatform Condition="'$(RuntimeIdentifier)' == 'ios-arm64'">Debug-iphoneos</_WidgetPlatform>
    <_WidgetPlatform Condition="'$(RuntimeIdentifier)' != 'ios-arm64'">Debug-iphonesimulator</_WidgetPlatform>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(_WidgetProducts)/$(_WidgetPlatform)/LibationWidgetExtension.appex') And Exists('$(_WidgetProducts)/$(_WidgetPlatform)/LibationWidgetBridge.framework')">
    <AdditionalAppExtensions Include="$(_WidgetProducts)">
      <Name>LibationWidgetExtension</Name>
      <BuildOutput>$(_WidgetPlatform)</BuildOutput>
      <CodesignEntitlements Condition="'$(_WidgetPlatform)' == 'Debug-iphoneos'">$(_WidgetProducts)/LibationWidgetExtension.entitlements</CodesignEntitlements>
    </AdditionalAppExtensions>
    <NativeReference Include="$(_WidgetProducts)/$(_WidgetPlatform)/LibationWidgetBridge.framework">
      <Kind>Framework</Kind>
      <SmartLink>False</SmartLink>
    </NativeReference>
  </ItemGroup>

  <!-- Siri and Shortcuts, also from Widget/build-widget.sh: an App Intents extension. It belongs in the app's Extensions/
       folder, where .NET's AdditionalAppExtensions cannot put it, so it is copied in, already signed by Xcode, before
       the app is signed. -->
  <Target Name="_EmbedIntentsExtension" AfterTargets="_CopyAppExtensionsToBundle" BeforeTargets="_ComputeCodesignItems"
          Condition="Exists('$(_WidgetProducts)/$(_WidgetPlatform)/LibationIntentsExtension.appex')">
    <Exec Command="mkdir -p &quot;$(_AppBundlePath)Extensions&quot; &amp;&amp; rm -rf &quot;$(_AppBundlePath)Extensions/LibationIntentsExtension.appex&quot; &amp;&amp; ditto &quot;$(_WidgetProducts)/$(_WidgetPlatform)/LibationIntentsExtension.appex&quot; &quot;$(_AppBundlePath)Extensions/LibationIntentsExtension.appex&quot;" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\LibationMobile\LibationMobile.csproj" />
  </ItemGroup>

  <!-- Kokoro on the GPU (MLX), built by Native/build-kokoro-gpu.sh, for devices; without it Kokoro runs on the CPU. -->
  <Import Project="Native/KokoroGPU.props" Condition="Exists('Native/KokoroGPU.props')" />

  <ItemGroup>
    <!-- eSpeak NG 1.52, built by Native/build-espeak.sh: words to phonemes for Kokoro, and the formant "Eloquence"
         voices. Its English data is in Resources/espeak-ng-data. -->
    <NativeReference Include="Native/espeak-ng.xcframework">
      <Kind>Static</Kind>
      <ForceLoad>True</ForceLoad>
    </NativeReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.400" />
  </ItemGroup>

</Project>
