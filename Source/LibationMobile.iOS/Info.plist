<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Libation</string>
	<key>CFBundleIdentifier</key>
	<string>io.github.freddygaffey.libationmobile</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MinimumOSVersion</key>
	<string>16.0</string>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<!-- Asked once: what you were doing while listening (walking, still, driving), from the phone's own motion record,
	     for your listening research. -->
	<key>NSMotionUsageDescription</key>
	<string>Libation notes whether you were walking, still or driving while you listened, and, if you turn on pausing when you fall asleep, whether your head (with AirPods) or the phone has been still. It stays on your phone.</string>
	<!-- Asked only when "Sleep from Apple Health" is connected: sleep a watch app (Garmin Connect, Apple Watch) wrote. -->
	<key>NSHealthShareUsageDescription</key>
	<string>Libation reads your sleep from Apple Health to mark where in a book you fell asleep, so you can go back to it. Nothing is written to Apple Health, and nothing leaves your phone.</string>
	<!-- Asked when "Ask aloud when I pause on headphones" is turned on: the spoken answer, 0 to 4. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>When you pause on your headphones, Libation can ask how well you followed and listen for you to say a number. It listens only for those few seconds.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Libation recognises the number you say in answer to its question, on your phone where it can.</string>
	<!-- Siri also answers to "Speed": "Hey Siri, Speed play", "Speed 7.3". -->
	<key>INAlternativeAppNames</key>
	<array>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Speed</string>
			<key>INAlternativeAppNamePronunciationHint</key>
			<string>speed</string>
		</dict>
	</array>
	<!-- The home-screen widget's play and recent-book buttons open the app with these links (HomeWidget.LINK_SCHEME). -->
	<!-- PDFs, EPUBs and text shared from Safari, Files or Mail open here, to be voiced. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Document to voice</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.adobe.pdf</string>
				<string>org.idpf.epub-container</string>
				<string>public.plain-text</string>
			</array>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>io.github.freddygaffey.libation.widget</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>libation-player</string>
			</array>
		</dict>
	</array>
	<!-- Keep playing with the screen locked or another app in front. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<!-- A slow voice (Kokoro) reads a book ahead to disk while the phone charges, usually overnight. -->
		<string>processing</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>io.github.freddygaffey.libation.voicing</string>
		<!-- A transcript carries on after the app leaves the screen, its progress on the lock screen. -->
		<string>io.github.freddygaffey.libation.transcribe</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
