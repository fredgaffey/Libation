<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LibationMobile.ViewModels"
             xmlns:controls="using:LibationMobile.Controls"
             x:Class="LibationMobile.Views.LibraryView"
             x:DataType="vm:MainViewModel">

	<UserControl.Styles>
		<!-- Filter choices: small pills, the chosen one lit. -->
		<Style Selector="Button.chip">
			<Setter Property="Background" Value="{StaticResource Slate}" />
			<Setter Property="Foreground" Value="{StaticResource Paper}" />
			<Setter Property="Padding" Value="12,7" />
			<Setter Property="Margin" Value="0,0,8,8" />
			<Setter Property="CornerRadius" Value="16" />
			<Setter Property="FontSize" Value="13" />
		</Style>
		<Style Selector="Button.chip.selected">
			<Setter Property="Background" Value="{StaticResource Lamp}" />
			<Setter Property="Foreground" Value="{StaticResource Ink}" />
		</Style>
		<Style Selector="Button.chip:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{Binding $parent[Button].Background}" />
			<Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
		</Style>
		<Style Selector="Button.quiet.lit">
			<Setter Property="Foreground" Value="{StaticResource Lamp}" />
		</Style>
		<!-- The All / Downloaded filter: plain text, the chosen one lit and underlined. -->
		<Style Selector="Button.filter">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Padding" Value="0,6" />
			<Setter Property="Margin" Value="0,0,20,0" />
			<Setter Property="BorderThickness" Value="0,0,0,2" />
			<Setter Property="BorderBrush" Value="Transparent" />
			<Setter Property="CornerRadius" Value="0" />
			<Setter Property="Foreground" Value="{StaticResource Dust}" />
			<Setter Property="FontSize" Value="15" />
		</Style>
		<Style Selector="Button.filter.selected">
			<Setter Property="BorderBrush" Value="{StaticResource Lamp}" />
			<Setter Property="Foreground" Value="{StaticResource Paper}" />
		</Style>
		<Style Selector="Button.filter:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
		</Style>

		<!-- The list is only for scrolling; rows are buttons, so drop ListBox's own selection look. -->
		<Style Selector="ListBox.books ListBoxItem">
			<Setter Property="Padding" Value="0" />
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="ListBox.books ListBoxItem:selected /template/ ContentPresenter, ListBox.books ListBoxItem:pointerover /template/ ContentPresenter, ListBox.books ListBoxItem:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<!-- The row itself: no hover box (there is no hover on a phone), and a light press tint. -->
		<Style Selector="Button.row:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="Button.row:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource Hairline}" />
		</Style>
	</UserControl.Styles>

	<Grid RowDefinitions="Auto,Auto,Auto,Auto,*">

		<Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" Margin="20,16,8,4">
			<TextBlock Classes="bookTitle" Text="Library" FontSize="30" VerticalAlignment="Center" />
			<Panel Grid.Column="1" Width="48" Height="48">
				<ProgressBar IsIndeterminate="True" IsVisible="{Binding Library.IsSyncing}" MinWidth="0" Width="28" VerticalAlignment="Center" Foreground="{StaticResource Lamp}" />
				<Button Classes="transport" Width="48" Height="48" Command="{Binding Library.SyncCommand}" IsVisible="{Binding !Library.IsSyncing}"
					ToolTip.Tip="Refresh library">
					<PathIcon Data="{StaticResource IconRefresh}" Width="20" Height="20" />
				</Button>
			</Panel>
			<Button Grid.Column="2" Classes="transport" Width="48" Height="48" Command="{Binding ShowSettingsCommand}" ToolTip.Tip="Settings">
				<PathIcon Data="{StaticResource IconSettings}" Width="20" Height="20" />
			</Button>
			<Button Grid.Column="3" Classes="transport" Width="48" Height="48" ToolTip.Tip="Account">
				<PathIcon Data="{StaticResource IconMore}" Width="20" Height="20" />
				<Button.Flyout>
					<MenuFlyout Placement="BottomEdgeAlignedRight">
						<MenuItem Header="{Binding AccountText}" IsEnabled="False" />
						<MenuItem Header="Listening log" Command="{Binding ShowLogCommand}" />
						<MenuItem Header="Copy shown books as JSON" Click="CopyJson_Click" />
						<MenuItem Header="Save shown books as JSON…" Click="SaveJson_Click" />
						<MenuItem Header="Sign out" Command="{Binding SignOutCommand}" />
					</MenuFlyout>
				</Button.Flyout>
			</Button>
		</Grid>

		<Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto" Margin="20,0,12,8">
			<TextBox Name="searchBox" Text="{Binding Library.SearchText}" PlaceholderText="Search titles, authors, narrators" />
			<Button Grid.Column="1" Classes="quiet" Content="Clear" Padding="10,8" Margin="8,0,0,0"
				IsVisible="{Binding Library.IsSearching}" Command="{Binding Library.ClearSearchCommand}" />
			<Button Grid.Column="2" Classes="quiet" Classes.lit="{Binding Library.HasActiveFilters}" Content="{Binding Library.FilterButtonText}" ToolTip.Tip="Filter and sort" Padding="10,8" Margin="8,0,0,0"
				Command="{Binding Library.ToggleFilterPanelCommand}" />
			<!-- Narrow the list: by how far through, by length, and by whether the book is part of a series. -->
			<StackPanel Grid.Row="1" Grid.ColumnSpan="3" Spacing="4" Margin="0,10,0,0" IsVisible="{Binding Library.IsFilterPanelOpen}">
				<TextBlock Classes="muted" Text="Sort by" FontSize="12" />
				<WrapPanel>
					<Button Classes="chip" Classes.selected="{Binding Library.IsSortListened}" Content="Last activity" Command="{Binding Library.SortByCommand}" CommandParameter="listened" />
					<Button Classes="chip" Classes.selected="{Binding Library.IsSortFinished}" Content="Recently finished" Command="{Binding Library.SortByCommand}" CommandParameter="finished" />
					<Button Classes="chip" Classes.selected="{Binding Library.IsSortRecent}" Content="Newest" Command="{Binding Library.SortByCommand}" CommandParameter="recent" />
					<Button Classes="chip" Classes.selected="{Binding Library.IsSortInProgress}" Content="In progress" Command="{Binding Library.SortByCommand}" CommandParameter="progress" />
					<Button Classes="chip" Classes.selected="{Binding Library.IsSortTitle}" Content="Title" Command="{Binding Library.SortByCommand}" CommandParameter="title" />
					<Button Classes="chip" Classes.selected="{Binding Library.IsSortAuthor}" Content="Author" Command="{Binding Library.SortByCommand}" CommandParameter="author" />
				</WrapPanel>
				<TextBlock Classes="muted" Text="Listening" FontSize="12" />
				<WrapPanel>
					<Button Classes="chip" Classes.selected="{Binding Library.IsProgressAny}" Content="Any" Command="{Binding Library.SetProgressFilterCommand}" CommandParameter="any" />
					<Button Classes="chip" Classes.selected="{Binding Library.IsProgressNotStarted}" Content="Not started" Command="{Binding Library.SetProgressFilterCommand}" CommandParameter="notstarted" />
					<Button Classes="chip" Classes.selected="{Binding Library.IsProgressStarted}" Content="In progress" Command="{Binding Library.SetProgressFilterCommand}" CommandParameter="started" />
					<Button Classes="chip" Classes.selected="{Binding Library.IsProgressFinished}" Content="Finished" Command="{Binding Library.SetProgressFilterCommand}" CommandParameter="finished" />
				</WrapPanel>
				<TextBlock Classes="muted" Text="Length" FontSize="12" />
				<WrapPanel>
					<Button Classes="chip" Classes.selected="{Binding Library.IsLengthAny}" Content="Any" Command="{Binding Library.SetLengthFilterCommand}" CommandParameter="any" />
					<Button Classes="chip" Classes.selected="{Binding Library.IsLengthShort}" Content="Under 5 h" Command="{Binding Library.SetLengthFilterCommand}" CommandParameter="short" />
					<Button Classes="chip" Classes.selected="{Binding Library.IsLengthMedium}" Content="5 to 15 h" Command="{Binding Library.SetLengthFilterCommand}" CommandParameter="medium" />
					<Button Classes="chip" Classes.selected="{Binding Library.IsLengthLong}" Content="Over 15 h" Command="{Binding Library.SetLengthFilterCommand}" CommandParameter="long" />
				</WrapPanel>
				<TextBlock Classes="muted" Text="Series and extras" FontSize="12" />
				<WrapPanel>
					<Button Classes="chip" Classes.selected="{Binding Library.IsSeriesAny}" Content="Any" Command="{Binding Library.SetSeriesFilterCommand}" CommandParameter="any" />
					<Button Classes="chip" Classes.selected="{Binding Library.IsSeriesOnly}" Content="In a series" Command="{Binding Library.SetSeriesFilterCommand}" CommandParameter="series" />
					<Button Classes="chip" Classes.selected="{Binding Library.IsStandaloneOnly}" Content="Standalone" Command="{Binding Library.SetSeriesFilterCommand}" CommandParameter="standalone" />
					<Button Classes="chip" Classes.selected="{Binding Library.IsPdfOnly}" Content="Has a PDF" Command="{Binding Library.TogglePdfFilterCommand}" />
				</WrapPanel>
				<Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4,0,0">
					<TextBlock Classes="muted" Text="{Binding Library.ResultCountText}" FontSize="13" VerticalAlignment="Center" />
					<!-- These books with their listening history, for pasting into an AI. -->
					<Button Grid.Column="1" Classes="quiet" Content="Export JSON" Padding="10,6">
						<Button.Flyout>
							<MenuFlyout Placement="BottomEdgeAlignedRight">
								<MenuItem Header="Copy to clipboard" Click="CopyJson_Click" />
								<MenuItem Header="Save as a file…" Click="SaveJson_Click" />
							</MenuFlyout>
						</Button.Flyout>
					</Button>
					<Button Grid.Column="2" Classes="quiet" Content="Clear all" Padding="10,6" Command="{Binding Library.ClearFiltersCommand}" />
				</Grid>
			</StackPanel>
		</Grid>

		<!-- Row 2 held the All / Downloaded filter, now the Downloads tab. -->

		<TextBlock
			Grid.Row="3"
			Margin="20,4,20,8"
			Classes="muted"
			Text="{Binding Library.Message}"
			IsVisible="{Binding Library.Message, Converter={x:Static ObjectConverters.IsNotNull}}"
			TextWrapping="Wrap" />

		<StackPanel Grid.Row="4" Margin="20,40,20,0" Spacing="10" IsVisible="{Binding Library.IsLibraryEmpty}">
			<TextBlock Classes="bookTitle" Text="Your library is empty" FontSize="20" />
			<TextBlock Classes="muted" TextWrapping="Wrap" MaxWidth="360" HorizontalAlignment="Left"
				Text="Books you buy on Audible appear here. Pull them in with Refresh library." />
		</StackPanel>

		<StackPanel Grid.Row="4" Margin="20,40,20,0" Spacing="10" IsVisible="{Binding Library.IsSearchEmpty}">
			<TextBlock Classes="bookTitle" Text="No books match" FontSize="20" />
			<TextBlock Classes="muted" TextWrapping="Wrap" MaxWidth="360" HorizontalAlignment="Left"
				Text="Try fewer words or fewer filters." />
		</StackPanel>

		<!-- ListBox virtualizes: only rows on screen are built, which matters for libraries of hundreds of books. -->
		<ListBox Grid.Row="4" Name="bookList" Classes="books" ItemsSource="{Binding Library.Books}" SelectionMode="Single" Background="Transparent">
				<ListBox.ItemTemplate>
					<DataTemplate x:DataType="vm:BookItemViewModel">
						<Grid ColumnDefinitions="*,Auto,Auto,Auto">
							<Button
								Grid.Column="0"
								Classes="row"
								Background="Transparent"
								HorizontalAlignment="Stretch"
								HorizontalContentAlignment="Stretch"
								CornerRadius="0"
								Padding="20,12,8,12"
								Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenBookCommand}"
								CommandParameter="{Binding}">
								<Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
									<Border Width="64" Height="64" CornerRadius="3" ClipToBounds="True" Background="{StaticResource Slate}" VerticalAlignment="Top">
										<Image Source="{Binding Cover}" Stretch="UniformToFill" />
									</Border>
									<StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
										<TextBlock Classes="bookTitle" Text="{Binding Title}" FontSize="16" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
										<TextBlock Classes="muted" Text="{Binding Author}" FontSize="13" TextTrimming="CharacterEllipsis" />
										<TextBlock Classes="muted" Text="{Binding StatusText}" FontSize="12" Margin="0,4,0,0" />
										<ProgressBar
											Height="2"
											MinHeight="2"
											Margin="0,6,0,0"
											Minimum="0"
											Maximum="1"
											Value="{Binding Progress}"
											IsVisible="{Binding HasProgress}"
											Foreground="{StaticResource Lamp}"
											Background="{StaticResource Hairline}" />
									</StackPanel>
								</Grid>
							</Button>

							<!-- Not on the phone: play it now, streamed from Audible, without waiting for the download. -->
							<Button Grid.Column="1" Classes="transport" Width="44" Height="48"
								IsVisible="{Binding !IsDownloaded}"
								Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).StreamBookCommand}" CommandParameter="{Binding}"
								ToolTip.Tip="Play without downloading">
								<PathIcon Data="{StaticResource IconPlay}" Width="18" Height="18" Margin="2,0,0,0" />
							</Button>

							<!-- Download marker: download, cancel, or show that the book is on the device. -->
							<Panel Grid.Column="2" Width="48">
								<Button Classes="transport" Width="48" Height="48"
									IsVisible="{Binding IsNotDownloaded}"
									Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Library.DownloadCommand}" CommandParameter="{Binding}"
									ToolTip.Tip="Download">
									<controls:DownloadGlyph State="{Binding State}" />
								</Button>
								<Button Classes="transport" Width="48" Height="48"
									IsVisible="{Binding IsDownloading}"
									Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Library.CancelDownloadCommand}" CommandParameter="{Binding}"
									ToolTip.Tip="Cancel download">
									<controls:DownloadGlyph State="{Binding State}" Progress="{Binding DownloadProgress}" />
								</Button>
								<controls:DownloadGlyph
									IsVisible="{Binding IsDownloaded}"
									State="{Binding State}"
									Width="22"
									Height="22"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									ToolTip.Tip="Downloaded" />
							</Panel>

							<!-- Per-book actions, like the Audible app's row menu. -->
							<Button Grid.Column="3" Classes="transport" Width="40" Height="48" Margin="0,0,4,0" ToolTip.Tip="More">
								<PathIcon Data="{StaticResource IconMore}" Width="18" Height="18" Foreground="{StaticResource Dust}" />
								<Button.Flyout>
									<MenuFlyout Placement="BottomEdgeAlignedRight">
										<MenuItem Header="Details and series"
											Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ShowDetailsCommand}" CommandParameter="{Binding}" />
										<MenuItem Header="Download the whole series" IsVisible="{Binding IsInSeries}"
											Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).DownloadSeriesOfCommand}" CommandParameter="{Binding}" />
										<MenuItem Header="Open the PDF" IsVisible="{Binding HasPdf}"
											Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenBookPdfCommand}" CommandParameter="{Binding}" />
										<MenuItem Header="Play from the start" IsVisible="{Binding IsDownloaded}"
											Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).PlayFromStartCommand}" CommandParameter="{Binding}" />
										<MenuItem Header="Mark as finished" IsVisible="{Binding IsNotFinished}"
											Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).MarkFinishedCommand}" CommandParameter="{Binding}" />
										<MenuItem Header="Mark as not started" IsVisible="{Binding HasProgress}"
											Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).MarkNotStartedCommand}" CommandParameter="{Binding}" />
										<MenuItem Header="Cancel download" IsVisible="{Binding IsDownloading}"
											Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Library.CancelDownloadCommand}" CommandParameter="{Binding}" />
										<MenuItem Header="Remove download" IsVisible="{Binding IsDownloaded}"
											Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RemoveDownloadCommand}" CommandParameter="{Binding}" />
									</MenuFlyout>
								</Button.Flyout>
							</Button>

							<Border Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom" Margin="20,0,0,0" Background="{StaticResource Hairline}" />
						</Grid>
					</DataTemplate>
				</ListBox.ItemTemplate>
		</ListBox>
	</Grid>
</UserControl>
