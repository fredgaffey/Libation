<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LibationMobile.ViewModels"
             xmlns:controls="using:LibationMobile.Controls"
             x:Class="LibationMobile.Views.ListeningLogView"
             x:DataType="vm:MainViewModel"
             Background="{StaticResource Ink}">

	<UserControl.Styles>
		<Style Selector="Button.choice">
			<Setter Property="Background" Value="{StaticResource Slate}" />
			<Setter Property="Foreground" Value="{StaticResource Paper}" />
			<Setter Property="Padding" Value="14,10" />
			<Setter Property="Margin" Value="0,0,8,0" />
			<Setter Property="MinWidth" Value="56" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="CornerRadius" Value="6" />
		</Style>
		<Style Selector="Button.choice.selected">
			<Setter Property="Background" Value="{StaticResource Lamp}" />
			<Setter Property="Foreground" Value="{StaticResource Ink}" />
		</Style>
		<!-- Paging arrows: a disabled one fades rather than turning into a grey disc. -->
		<Style Selector="Button.transport:disabled /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="Button.transport:disabled">
			<Setter Property="Opacity" Value="0.25" />
		</Style>
		<Style Selector="Button.choice:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{Binding $parent[Button].Background}" />
			<Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
		</Style>
	</UserControl.Styles>

	<Grid RowDefinitions="Auto,*">
		<Grid ColumnDefinitions="Auto,*,Auto" Margin="12,4,16,4">
			<Button Classes="transport" Width="48" Height="48" Command="{Binding GoToLibraryCommand}" ToolTip.Tip="Back">
				<PathIcon Data="{StaticResource IconChevronDown}" />
			</Button>
			<TextBlock Grid.Column="1" Classes="bookTitle" Text="Listening stats" FontSize="24" VerticalAlignment="Center" Margin="4,0,0,0" />
			<Button Grid.Column="2" Classes="quiet" Content="{Binding Log.ClearText}" Padding="10,6" Command="{Binding Log.ClearLogCommand}" IsVisible="{Binding !Log.IsEmpty}" />
		</Grid>

		<ScrollViewer Grid.Row="1" x:Name="Scroller">
			<StackPanel Margin="0,0,0,32">
				<!-- Time saved: what speed listening has given back, as the page's one big figure. -->
				<StackPanel Margin="24,8,24,0" Spacing="2">
					<TextBlock Text="{Binding Log.SavedHero}" FontFamily="{StaticResource DisplayFont}" FontWeight="Light" FontSize="64"
						Foreground="{StaticResource Lamp}" />
					<TextBlock Text="{Binding Log.SavedHeroUnit}" FontSize="17" Margin="3,-6,0,0" />
					<!-- The books' length as a bar: the part spent listening, and the rest, saved. -->
					<ProgressBar Minimum="0" Maximum="100" Value="{Binding Log.RealShare}" Height="10" MinHeight="10" CornerRadius="5" Margin="0,16,0,6"
						Foreground="{StaticResource Dust}" Background="{StaticResource Lamp}" />
					<Grid ColumnDefinitions="*,Auto">
						<StackPanel Orientation="Horizontal" Spacing="6">
							<Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource Dust}" VerticalAlignment="Center" />
							<TextBlock Classes="muted" Text="{Binding Log.RealTotalText}" FontSize="12" />
						</StackPanel>
						<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
							<Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource Lamp}" VerticalAlignment="Center" />
							<TextBlock Classes="muted" Text="{Binding Log.BookTotalText}" FontSize="12" />
						</StackPanel>
					</Grid>
					<TextBlock Classes="muted" Text="{Binding Log.SavedHeroDetail}" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0" />
				</StackPanel>

				<!-- At a glance. -->
				<ItemsControl ItemsSource="{Binding Log.Tiles}" Margin="18,18,18,0">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:StatTile">
							<Border Background="{StaticResource Slate}" CornerRadius="10" Padding="12,12" Margin="6">
								<StackPanel Spacing="2">
									<TextBlock Text="{Binding Value}" FontFamily="{StaticResource DisplayFont}" FontSize="28" />
									<TextBlock Classes="muted" Text="{Binding Label}" FontSize="11" TextWrapping="Wrap" />
								</StackPanel>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<!-- Listening over time, as Audible's: a range, its total over the chart, and a tapped bar's own figure. -->
				<Border Background="{StaticResource Slate}" CornerRadius="10" Padding="16,14" Margin="24,12,24,0">
					<StackPanel Spacing="10">
						<UniformGrid Columns="3">
							<Button Classes="choice" Classes.selected="{Binding Log.IsByDay}" Content="Days" Command="{Binding Log.ShowByDayCommand}" Margin="0,0,4,0" HorizontalAlignment="Stretch" />
							<Button Classes="choice" Classes.selected="{Binding Log.IsByMonth}" Content="Months" Command="{Binding Log.ShowByMonthCommand}" Margin="2,0" HorizontalAlignment="Stretch" />
							<Button Classes="choice" Classes.selected="{Binding Log.IsByYear}" Content="Years" Command="{Binding Log.ShowByYearCommand}" Margin="4,0,0,0" HorizontalAlignment="Stretch" />
						</UniformGrid>
						<Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
							<Button Classes="transport" Width="40" Height="40" Command="{Binding Log.OlderCommand}" IsVisible="{Binding Log.CanPage}" ToolTip.Tip="Earlier">
								<PathIcon Data="{StaticResource IconChevronDown}" Width="16" Height="16" RenderTransform="rotate(90deg)" />
							</Button>
							<StackPanel Grid.Column="1" HorizontalAlignment="Center">
								<TextBlock Classes="muted" Text="{Binding Log.PeriodLabel}" FontSize="13" HorizontalAlignment="Center" />
								<TextBlock Text="{Binding Log.PeriodValue}" FontFamily="{StaticResource DisplayFont}" FontSize="30" HorizontalAlignment="Center" />
								<TextBlock Classes="muted" Text="{Binding Log.PeriodDetail}" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
							</StackPanel>
							<Button Grid.Column="2" Classes="transport" Width="40" Height="40" Command="{Binding Log.NewerCommand}" IsVisible="{Binding Log.CanPage}" IsEnabled="{Binding Log.CanGoNewer}" ToolTip.Tip="Later">
								<PathIcon Data="{StaticResource IconChevronDown}" Width="16" Height="16" RenderTransform="rotate(-90deg)" />
							</Button>
						</Grid>
						<!-- Taller than the tallest bar and its label, so a full bar never runs into the day numbers. -->
						<ItemsControl ItemsSource="{Binding Log.Bars}" Height="164">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="vm:ChartBar">
									<Button Background="Transparent" Padding="1,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="False"
										HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
										Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Log.SelectBarCommand}" CommandParameter="{Binding}">
										<Grid RowDefinitions="*,Auto" Opacity="{Binding Opacity}">
											<StackPanel VerticalAlignment="Bottom">
												<Border Height="{Binding LibationHeight}" Background="{StaticResource Lamp}" CornerRadius="3,3,0,0" />
												<Border Height="{Binding AudibleHeight}" Background="{StaticResource Paper}" CornerRadius="3,3,0,0" />
											</StackPanel>
											<!-- Wider than its bar, so two-digit days show in full. -->
											<TextBlock Grid.Row="1" Classes="muted" Text="{Binding Label}" FontSize="10" HorizontalAlignment="Center" TextAlignment="Center"
												Margin="-12,4,-12,0" IsVisible="{Binding ShowLabel}" />
										</Grid>
									</Button>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
						<StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center">
							<StackPanel Orientation="Horizontal" Spacing="5">
								<Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource Paper}" VerticalAlignment="Center" />
								<TextBlock Classes="muted" Text="Audible app" FontSize="12" />
							</StackPanel>
							<StackPanel Orientation="Horizontal" Spacing="5">
								<Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource Lamp}" VerticalAlignment="Center" />
								<TextBlock Classes="muted" Text="Libation" FontSize="12" />
							</StackPanel>
						</StackPanel>
					</StackPanel>
				</Border>

				<!-- Every day of the last half year as a square, coloured by how much was listened, then when in the week it happens. -->
				<Border Background="{StaticResource Slate}" CornerRadius="10" Padding="16,14" Margin="24,12,24,0">
					<StackPanel Spacing="10">
						<TextBlock Text="Every day" FontSize="15" FontWeight="SemiBold" />
						<controls:HeatGrid Values="{Binding Log.CalendarValues}" Rows="7" RowLabels="{x:Static vm:ListeningLogViewModel.WeekdayLabels}"
							ColumnLabels="{Binding Log.CalendarColumns}" SelectedIndex="{Binding Log.SelectedCalendarDay}" />
						<TextBlock Classes="muted" Text="{Binding Log.CalendarDetail}" FontSize="12" TextWrapping="Wrap" />
						<TextBlock Text="When you listen" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" />
						<controls:HeatGrid Values="{Binding Log.HourValues}" Rows="7" RowLabels="{x:Static vm:ListeningLogViewModel.WeekdayLabels}"
							ColumnLabels="{x:Static vm:ListeningLogViewModel.HourLabels}" SelectedIndex="{Binding Log.SelectedHour}" />
						<TextBlock Classes="muted" Text="{Binding Log.HourDetail}" FontSize="12" TextWrapping="Wrap" />
						<StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
							<TextBlock Classes="muted" Text="Less" FontSize="11" VerticalAlignment="Center" Margin="0,0,2,0" />
							<Border Width="10" Height="10" CornerRadius="2" Background="#3C3852" />
							<Border Width="10" Height="10" CornerRadius="2" Background="#B59A73" />
							<Border Width="10" Height="10" CornerRadius="2" Background="#F0B25A" />
							<Border Width="10" Height="10" CornerRadius="2" Background="#EC9A5B" />
							<Border Width="10" Height="10" CornerRadius="2" Background="#E8745A" />
							<TextBlock Classes="muted" Text="More" FontSize="11" VerticalAlignment="Center" Margin="2,0,0,0" />
						</StackPanel>
					</StackPanel>
				</Border>

				<!-- Each app's share. -->
				<ItemsControl ItemsSource="{Binding Log.Apps}" Margin="18,6,18,0">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:AppShare">
							<Border Background="{StaticResource Slate}" CornerRadius="10" Padding="14,12" Margin="6">
								<StackPanel Spacing="6">
									<Grid ColumnDefinitions="*,Auto">
										<TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
										<TextBlock Grid.Column="1" Text="{Binding Speed}" FontSize="15" Foreground="{StaticResource Lamp}" />
									</Grid>
									<Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="2">
										<TextBlock Classes="muted" Text="Listening" FontSize="12" />
										<TextBlock Grid.Column="1" Text="{Binding Real}" FontSize="12" />
										<TextBlock Grid.Row="1" Classes="muted" Text="Books" FontSize="12" />
										<TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Book}" FontSize="12" />
										<TextBlock Grid.Row="2" Classes="muted" Text="Saved" FontSize="12" />
										<TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Saved}" FontSize="12" Foreground="{StaticResource Lamp}" />
									</Grid>
									<TextBlock Classes="muted" Text="{Binding Note}" FontSize="11" TextWrapping="Wrap" />
								</StackPanel>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<!-- Finished on Audible, newest first, with covers. -->
				<StackPanel IsVisible="{Binding Log.HasFinished}" Margin="0,22,0,0">
					<TextBlock Text="Recently finished" FontFamily="{StaticResource DisplayFont}" FontSize="22" Margin="24,0,24,10" />
					<ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
						<ItemsControl ItemsSource="{Binding Log.Finished}" Margin="18,0">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="vm:FinishedRow">
									<StackPanel Width="112" Margin="6,0" Spacing="4">
										<Border Width="112" Height="112" CornerRadius="6" ClipToBounds="True" Background="{StaticResource Slate}">
											<Image Source="{Binding Book.Cover}" Stretch="UniformToFill" />
										</Border>
										<TextBlock Text="{Binding Title}" FontSize="12" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
										<TextBlock Classes="muted" Text="{Binding DateText}" FontSize="11" />
									</StackPanel>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
				</StackPanel>

				<!-- The listener's own research: how well followed against syllables a second, and blind trial results. -->
				<TextBlock Text="Your research" FontFamily="{StaticResource DisplayFont}" FontSize="22" Margin="24,24,24,4" />
				<TextBlock Classes="muted" Text="{Binding Log.ResearchSummary}" FontSize="13" TextWrapping="Wrap" Margin="24,0,24,8" />
				<Border Background="{StaticResource Slate}" CornerRadius="10" Padding="14,12" Margin="24,0,24,8" IsVisible="{Binding Log.FollowBars.Count}">
					<StackPanel Spacing="6">
						<TextBlock Text="How well you followed, by syllables a second" FontSize="14" />
						<ItemsControl ItemsSource="{Binding Log.FollowBars}" Height="84">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="vm:FollowBar">
									<Grid RowDefinitions="*,Auto" Width="30" ToolTip.Tip="{Binding ValueText}">
										<Border Height="{Binding Height}" VerticalAlignment="Bottom" Background="{StaticResource Lamp}" CornerRadius="2,2,0,0" />
										<TextBlock Grid.Row="1" Classes="muted" Text="{Binding Label}" FontSize="10" HorizontalAlignment="Center" />
									</Grid>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
						<TextBlock Classes="muted" Text="Bar height: average rating out of 5. Label: syllables a second, from." FontSize="11" />
					</StackPanel>
				</Border>
				<StackPanel Orientation="Horizontal" Spacing="8" Margin="24,0,24,8">
					<Button Classes="quiet" Content="Copy research data" Padding="12,8" Click="CopyResearch_Click" />
					<Button Classes="quiet" Content="Save as a file…" Padding="12,8" Click="SaveResearch_Click" />
				</StackPanel>
				<ItemsControl ItemsSource="{Binding Log.Research}" Margin="24,0,24,0">
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:ResearchRow">
							<Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource Hairline}" Padding="0,8">
								<StackPanel Spacing="2">
									<TextBlock Text="{Binding Title}" FontSize="15" />
									<ItemsControl ItemsSource="{Binding Lines}">
										<ItemsControl.ItemTemplate>
											<DataTemplate><TextBlock Classes="muted" Text="{Binding}" FontSize="12" TextWrapping="Wrap" /></DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
									<TextBlock Text="{Binding Verdict}" FontSize="12" Foreground="{StaticResource Lamp}" IsVisible="{Binding Verdict, Converter={x:Static ObjectConverters.IsNotNull}}" />
								</StackPanel>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<!-- Each day's sessions on this phone. -->
				<TextBlock Text="Sessions in Libation" FontFamily="{StaticResource DisplayFont}" FontSize="22" Margin="24,24,24,0" />
				<TextBlock Classes="muted" TextWrapping="Wrap" Margin="24,6,24,0" IsVisible="{Binding Log.IsEmpty}"
					Text="Each time you listen for more than half a minute, it is noted here: when, which book, for how long, and how much of the book that covered. Each book's own history is under History in the player." />
				<ItemsControl ItemsSource="{Binding Log.Days}">
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:LogDayViewModel">
							<StackPanel Margin="0,16,0,0">
								<TextBlock Text="{Binding Header}" FontSize="16" Margin="24,0" />
								<TextBlock Classes="muted" Text="{Binding TotalText}" FontSize="13" Margin="24,2,24,6" />
								<!-- When in the day each session ran, coloured by its speed. -->
								<controls:DayTimeline Blocks="{Binding Blocks}" Margin="24,0,24,6" />
								<ItemsControl ItemsSource="{Binding Entries}">
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="vm:LogEntryViewModel">
											<Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource Hairline}" Padding="24,10">
												<StackPanel Spacing="2">
													<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
														<Border Width="8" Height="8" CornerRadius="4" Background="{Binding SpeedBrush}" VerticalAlignment="Center" />
														<TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="15" TextTrimming="CharacterEllipsis" />
														<TextBlock Grid.Column="2" Classes="muted" Text="{Binding TimeText}" FontSize="13" />
													</Grid>
													<TextBlock Classes="muted" Text="{Binding DetailText}" FontSize="12" TextWrapping="Wrap" />
												</StackPanel>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
				<!-- How the figures are worked out, Audible's freshness, and the fallback speed. -->
				<Border Background="{StaticResource Slate}" CornerRadius="10" Padding="16,14" Margin="24,24,24,0">
					<StackPanel Spacing="8">
						<TextBlock Text="How this is worked out" FontSize="15" FontWeight="SemiBold" />
						<TextBlock Classes="muted" Text="{Binding Log.HowWorkedOut}" FontSize="12" TextWrapping="Wrap" />
						<Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
							<TextBlock Text="Audible speed if it can't be worked out" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
							<Button Grid.Column="1" Classes="quiet" Content="−" Padding="12,4" Command="{Binding Log.ChangeAudibleDefaultCommand}" CommandParameter="-0.1" />
							<TextBlock Grid.Column="2" Text="{Binding Log.AudibleDefaultText}" FontSize="13" Foreground="{StaticResource Lamp}" VerticalAlignment="Center" MinWidth="36" TextAlignment="Center" />
							<Button Grid.Column="3" Classes="quiet" Content="+" Padding="12,4" Command="{Binding Log.ChangeAudibleDefaultCommand}" CommandParameter="0.1" />
						</Grid>
						<Grid ColumnDefinitions="*,Auto">
							<TextBlock Classes="muted" Text="{Binding Log.AudibleStatus}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
							<Panel Grid.Column="1" Width="44" Height="44">
								<ProgressBar IsIndeterminate="True" IsVisible="{Binding Log.IsRefreshing}" MinWidth="0" Width="24" VerticalAlignment="Center" Foreground="{StaticResource Lamp}" />
								<Button Classes="transport" Width="44" Height="44" Command="{Binding Log.RefreshFromAudibleCommand}" IsVisible="{Binding !Log.IsRefreshing}" ToolTip.Tip="Get Audible's figures">
									<PathIcon Data="{StaticResource IconRefresh}" Width="18" Height="18" />
								</Button>
							</Panel>
						</Grid>
					</StackPanel>
				</Border>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</UserControl>
